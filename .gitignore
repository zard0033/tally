.env
.env.*
*.local
# 拋棄式探針（`*.local` 只匹配結尾是 .local 的檔名，蓋不到 foo.local.mjs）
*.local.mjs
client_secret*.json
*_pw.txt
*.pem
*.key

# 含真實個人健康資料，repo 是 public，永遠不進版控
seed.sql
migrate-v2.sql

# 本機 Claude Code agent 狀態，非專案內容
.claude/

# OMC（2026-10-14 起取代 session-state/active.md）：.omc/ 是本機執行期狀態，只追蹤跨機要接力的 notepad 與 wiki
# （.omc/.gitignore 是為了壓住 OMC 自動補的 wiki/ 忽略）
.omc/*
!.omc/.gitignore
!.omc/notepad.md
!.omc/wiki/

# Node / Vite
node_modules
dist
*.log
test-results/

# playwright MCP 工作目錄
.playwright-mcp/

# e2e 回歸 harness 產物
e2e/shots/
playwright-report/
blob-report/
